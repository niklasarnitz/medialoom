# MediaLoom Configuration

# SQLite database file URL
DATABASE_URL="file:./medialoom.db"

# TMDb API Token for metadata provider access
TMDB_API_TOKEN="your_tmdb_api_token_here"

# Path to the ffprobe binary (optional, defaults to ffprobe)
FFPROBE_PATH="ffprobe"

# Logging level: debug | info | warn | error (optional, defaults to info)
LOG_LEVEL="info"
