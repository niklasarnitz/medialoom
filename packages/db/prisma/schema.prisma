datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SystemMetadata {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Movie {
  id              String    @id @default(cuid())
  title           String
  originalTitle   String?
  year            Int?
  runtimeMinutes  Int?
  overview        String?
  status          String    @default("UNMATCHED")
  matchConfidence Float?
  matchDetails    String?
  tmdbId          Int?      @unique
  imdbId          String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  editions        Edition[]
  operationPlans  OperationPlan[]

  @@index([status])
}


model Edition {
  id            String         @id @default(cuid())
  movieId       String
  name          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  movie         Movie          @relation(fields: [movieId], references: [id], onDelete: Cascade)
  mediaVersions MediaVersion[]

  @@index([movieId])
}

model MediaVersion {
  id        String   @id @default(cuid())
  editionId String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  edition   Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  assets    Asset[]

  @@index([editionId])
}

model Asset {
  id                String                  @id @default(cuid())
  mediaVersionId    String
  type              String                  @default("VIDEO")
  path              String                  @unique
  sizeBytes         BigInt
  mtime             DateTime
  present           Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  mediaVersion      MediaVersion            @relation(fields: [mediaVersionId], references: [id], onDelete: Cascade)
  technicalMetadata MediaTechnicalMetadata?
  filenameMetadata  MediaFilenameMetadata?

  @@index([mediaVersionId])
}

model MediaTechnicalMetadata {
  id              String        @id @default(cuid())
  assetId         String        @unique
  container       String?
  formatName      String?
  durationSeconds Float?
  bitRate         BigInt?
  width           Int?
  height          Int?
  videoCodec      String?
  frameRate       Float?
  bitDepth        Int?
  hdrFormat       String?
  audioCodec      String?
  audioChannels   Int?
  audioLanguage   String?
  audioLayout     String?
  rawJson         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  asset           Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  streams         MediaStream[]
}

model MediaStream {
  id                  String                 @id @default(cuid())
  technicalMetadataId String
  index               Int
  streamType          String
  codec               String?
  codecLongName       String?
  profile             String?
  width               Int?
  height              Int?
  frameRate           Float?
  bitDepth            Int?
  hdrFormat           String?
  channels            Int?
  channelLayout       String?
  sampleRate          Int?
  bitRate             BigInt?
  language            String?
  title               String?
  isDefault           Boolean                @default(false)
  isForced            Boolean                @default(false)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  technicalMetadata   MediaTechnicalMetadata @relation(fields: [technicalMetadataId], references: [id], onDelete: Cascade)

  @@index([technicalMetadataId])
  @@index([streamType])
}

model MediaFilenameMetadata {
  id               String   @id @default(cuid())
  assetId          String   @unique
  title            String?
  year             Int?
  type             String?
  edition          String?
  screenSize       String?
  source           String?
  videoCodec       String?
  audioCodec       String?
  audioChannels    String?
  releaseGroup     String?
  streamingService String?
  container        String?
  language         String?
  rawJson          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  asset            Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model Scan {
  id              String    @id @default(cuid())
  rootPath        String
  status          String    @default("RUNNING")
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  discoveredCount Int       @default(0)
  createdCount    Int       @default(0)
  updatedCount    Int       @default(0)
  failedCount     Int       @default(0)
  errorMessage    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
}

model OperationPlan {
  id              String    @id @default(cuid())
  mediaItemId     String
  profile         String
  destinationRoot String
  status          String    @default("PENDING")
  operationsJson  String
  validationJson  String?
  failureReason   String?
  createdAt       DateTime  @default(now())
  validatedAt     DateTime?
  appliedAt       DateTime?
  updatedAt       DateTime  @updatedAt

  mediaItem       Movie     @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

  @@index([mediaItemId])
  @@index([status])
}

